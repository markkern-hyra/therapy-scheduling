# Скопіюйте у .env.local (він у .gitignore) і заповніть значеннями з вашого проєкту Supabase:
# Project Settings → API Keys (точну назву розділу перевірте в інтерфейсі). Значення ніколи не комітимо й не вставляємо в чат з агентом.

# Публічні (потрапляють у браузер; ці дві й лише ці — також у Vercel, Production і Preview):
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Лише скрипти (обходить RLS!), зараз — лише npm run users:demo. Ніколи з префіксом NEXT_PUBLIC_.
# У Vercel не додаємо ніколи:
SUPABASE_SECRET_KEY=sb_secret_...

# AI-функція (зріз 4, ADR 0010): ключ Claude API — один на команду, бюджет спільний. Лише сервер: у .env.local і у
# Vercel (Production). Ніколи з префіксом NEXT_PUBLIC_, ніколи в git, логах чи чаті. Читає ключ лише src/lib/ai/anthropic.ts.
# Порожньо — помічник «недоступний», форма нової картки працює вручну.
ANTHROPIC_API_KEY=

# Трекер помилок сервера (WS11, src/instrumentation.ts): бот і група алертів у Telegram. Лише сервер — у Vercel
# (Production і Preview) і за бажанням тут; ніколи з префіксом NEXT_PUBLIC_. Порожньо — повідомлень немає.
# Ті самі назви — секрети GitHub для алерту smoke.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Мітка середовища (WS11): у Vercel — лише Preview, гілка staging, значення staging. Локально не потрібна.
# APP_ENV=

# Один пароль для всіх синтетичних користувачів npm run users:demo (≥ 8 символів):
DEMO_USER_PASSWORD=

# Для Supabase MCP у Claude Code (.mcp.json читає змінну з оточення, а не з цього файлу):
# задайте її в терміналі перед запуском claude, напр. export SUPABASE_PROJECT_REF=<project-ref>
# SUPABASE_PROJECT_REF=
